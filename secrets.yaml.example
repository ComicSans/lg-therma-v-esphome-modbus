# Copy this file to secrets.yaml and fill it in.
# secrets.yaml itself is excluded via .gitignore and must never be
# committed to a repository.

wifi_ssid: "MyWiFi"
wifi_password: "your-wifi-password"

# Deliberately a SEPARATE password, not the one above. The fallback AP comes
# up when WiFi drops; whoever cracks it would otherwise get access to the
# whole network with a shared password.
ap_password: "a-different-password"

# Encryption of the Home Assistant API: 32 bytes, base64, generate with
#   openssl rand -base64 32
# Home Assistant asks for this key when adding the device. The placeholder is
# deliberately invalid; ESPHome rejects the configuration until a real key is
# set here.
api_key: "generate-a-key-here"

# Password for firmware updates over WiFi (OTA).
ota_password: "your-ota-password"
