# Diese Datei nach secrets.yaml kopieren und ausfüllen.
# secrets.yaml selbst ist über .gitignore ausgeschlossen und gehört
# niemals in ein Repository.

wlan_ssid: "MeinWLAN"
wlan_passwort: "hier-das-wlan-passwort"

# Bewusst ein EIGENES Passwort, nicht dasselbe wie oben. Der Fallback-AP
# geht auf, wenn das WLAN wegfällt — wer ihn dann knackt, hätte mit einem
# geteilten Passwort gleich Zugang zum ganzen Netz.
ap_passwort: "hier-ein-anderes-passwort"
